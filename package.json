{
  "name": "etchable",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "tauri": "pnpm --filter @etchable/desktop tauri",
    "desktop:build": "pnpm --filter @etchable/desktop build",
    "validate:circuit-json": "pnpm --filter @etchable/desktop --silent validate:circuit-json",
    "web": "pnpm --filter @etchable/web dev",
    "web:build": "pnpm --filter @etchable/web build",
    "web:deploy": "pnpm --filter @etchable/web run deploy"
  }
}
